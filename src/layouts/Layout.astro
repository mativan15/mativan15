---
import "../styles/global.css";

const siteRoot = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <script is:inline>
        (function () {
            let saved = "";
            try { saved = localStorage.getItem("site-lang") || ""; } catch { /* storage can be blocked */ }
            let fromUrl = "";
            try { fromUrl = new URLSearchParams(location.search).get("lang") || ""; } catch { /* query can be unreadable */ }
            function known(value) { return value === "en" || value === "pt" || value === "es"; }
            let lang = known(saved) ? saved : known(fromUrl) ? fromUrl : "";
            if (!lang) {
                const list = navigator.languages || [navigator.language || "en"];
                lang = "en";
                for (let i = 0; i < list.length; i += 1) {
                    const base = String(list[i] || "").toLowerCase().split("-")[0];
                    if (base === "pt" || base === "es" || base === "en") { lang = base; break; }
                }
            }
            document.documentElement.lang = lang;
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" data-i18n-content="meta.description" content="Portfolio of Ivan Matthias Sardon Medina, a Computer Science student and software developer focused on systems, networking, web, mobile, databases, and applied software.">
    <meta name="keywords" data-i18n-content="meta.keywords" content="Ivan Sardon, Ivan Matthias Sardon Medina, software developer, computer science, UCSP, C++, Flutter, React, networking, database systems">
    <meta name="author" content="Ivan Matthias Sardon Medina">
    <meta property="og:title" data-i18n-content="meta.ogTitle" content="Ivan Matthias Sardon Medina - Software Developer">
    <meta property="og:description" data-i18n-content="meta.ogDescription" content="Systems, networking, web, mobile, and product-oriented software portfolio.">
    <meta property="og:locale" data-i18n-content="meta.locale" content="en_US">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://mativan15.github.io/mativan15/myPhoto.jpg">
    <meta property="og:url" content="https://mativan15.github.io/mativan15/">
    <title data-i18n="meta.title">Ivan Matthias Sardon Medina | Software Developer</title>
    <link rel="canonical" href="https://mativan15.github.io/mativan15/">
    <link rel="icon" type="image/x-icon" href={siteRoot + "favicon.ico"}>
    <link rel="apple-touch-icon" href={siteRoot + "icon.png"}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <script id="person-data" type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Ivan Matthias Sardon Medina",
        "url": "https://mativan15.github.io/mativan15/",
        "image": "https://mativan15.github.io/mativan15/myPhoto.jpg",
        "email": "mailto:matthiassardon@gmail.com",
        "jobTitle": "Computer Science Student",
        "affiliation": [
            {
                "@type": "CollegeOrUniversity",
                "name": "Universidad Católica San Pablo"
            },
            {
                "@type": "CollegeOrUniversity",
                "name": "ICMC, Universidade de São Paulo"
            }
        ],
        "birthPlace": "Arequipa, Peru",
        "sameAs": [
            "https://github.com/mativan15",
            "https://www.linkedin.com/in/iv%C3%A1n-sard%C3%B3n-medina-47b16329b",
            "https://www.instagram.com/mat.ivaan/"
        ],
        "knowsAbout": [
            "C++",
            "CUDA",
            "Computer networking",
            "UNIX tools",
            "Flutter",
            "Computer vision"
        ]
    }
    </script>
</head>
<body>
    <slot />
    <script is:inline src={siteRoot + "boot.js"}></script>
</body>
</html>
